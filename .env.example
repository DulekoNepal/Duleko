# Copy this file to .env.local and fill in your Supabase project credentials.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the canonical site address used in shared profile links.
# Without it links use whatever host the app is open on, so a link
# shared from localhost or a preview deploy would be dead elsewhere.
VITE_SITE_URL=https://www.duleko.com
