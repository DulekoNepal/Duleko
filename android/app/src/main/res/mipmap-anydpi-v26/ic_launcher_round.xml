<?xml version="1.0" encoding="utf-8"?>
<!-- Both layers are full 108dp images (see mipmap-*/ic_launcher_foreground.png),
     so no inset: the logo's size is set in the image itself, ~26% larger than
     the old 72dp inset while staying inside the 66dp safe circle. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
